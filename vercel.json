{
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "routes": [
              { "src": "/api/dashboard", "dest": "/api/dashboard" },
              { "src": "/api/save-dashboard", "dest": "/api/save-dashboard" },
              { "src": "/api/bitrix-status", "dest": "/api/bitrix-status" },
              { "src": "/api/showcase-upload", "dest": "/api/showcase-upload" },
              { "src": "/(.*)", "dest": "/api/serve" }
      ],
      "functions": {
              "api/serve.js": {
                        "includeFiles": "dist/**"
              }
      }
}
