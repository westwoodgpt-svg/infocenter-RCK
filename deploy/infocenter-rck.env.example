# Переменные окружения инфоцентра на своём сервере.
# Лежит в /etc/infocenter-rck.env (права 640, root:infocenter).
# После правки: systemctl restart infocenter-rck

# --- обязательные ----------------------------------------------------------

# Локальный Redis на этом же сервере (ставит deploy/install.sh).
REDIS_URL=redis://127.0.0.1:6379

# «Ключ приложения» (client_id) и «Секретный ключ» (client_secret) локального
# приложения в Битрикс24 — те же значения, что были в Vercel
# (Settings → Environment Variables).
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=

# Куда класть вложения стикеров витрины. Раздаются по /uploads/.
UPLOAD_DIR=/var/lib/infocenter-rck/uploads

PORT=3000
HOST=127.0.0.1

# --- необязательные (перенесите из Vercel, если были заданы) ----------------

# INFOCENTER_LEGACY_DEPARTMENT_ID=
# INFOCENTER_HIDDEN_DEPARTMENTS=
# Отдел портала, который и есть РЦК: его сотрудники работают в «Инфоцентре
# РЦК» и только они (с руководителем, директором и администраторами) его
# правят; своего инфоцентра отдела у него нет. Задайте явно — тогда
# переименование отдела на портале ничего не сломает. Без значения отдел
# ищется по названию «Региональный центр компетенций в сфере производительности
# труда». Если структуру перестроят и номер отдела сменится — поменяйте здесь
# и выполните systemctl restart infocenter-rck.
INFOCENTER_RCK_DEPARTMENT_ID=115
# INFOCENTER_LEGACY_DEPARTMENT_ID — старый способ, оставьте пустым.
# INFOCENTER_RCK_COPY_* — больше не используются (разовая копия отключена).
# INFOCENTER_DIRECTOR_IDS=
# Наблюдатели (руководство фонда): ID сотрудников через запятую. Видят все
# инфоцентры и сводный экран, правят только по общим правилам.
# INFOCENTER_VIEWER_IDS=14,40,62,115,80
